{
  "name": "dev-recall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/verify-browser.ts",
    "build": "npm run validate:data && npm run check && vite build",
    "preview": "vite preview",
    "docs:sync": "tsx scripts/sync-docs.ts",
    "predev": "npm run docs:sync",
    "prebuild": "npm run docs:sync",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.3"
  }
}
